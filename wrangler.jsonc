{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lowfare-compass-api",
  "main": "worker.js",
  "compatibility_date": "2026-08-29",
  "vars": {
    "ALLOWED_ORIGINS": "https://gitanamomo.github.io,http://127.0.0.1:5500,http://localhost:5500",
    "ALLOW_DEMO": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lowfare-compass",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
